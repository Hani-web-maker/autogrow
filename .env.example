# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/autogrow"

# Public URL of the deployed app, and a random 32+ char secret for NextAuth
# (also used to sign GSC OAuth state and report-preview PDF tokens)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (Console: https://console.cloud.google.com)
# Enable: Google Search Console API
# Authorized redirect URI: <NEXTAUTH_URL>/api/integrations/gsc/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# Redis connection string. Use rediss:// for TLS-terminated providers (e.g. Upstash).
REDIS_URL="redis://localhost:6379"

# AWS S3 (PDF export storage)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# 32+ char key used to encrypt OAuth tokens and integration credentials at rest
ENCRYPTION_KEY="generate-with-openssl-rand-hex-16"
