generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  plan      String    @default("free")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  projects  Project[]
  promptTemplates PromptTemplate[]
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String       @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           String       @default("worker") // admin, manager, worker
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id])
  accounts       Account[]
  sessions       Session[]
  tasks          Task[]       @relation("AssignedTasks")
  createdTasks   Task[]       @relation("CreatedTasks")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id           String        @id @default(cuid())
  orgId        String
  organization Organization  @relation(fields: [orgId], references: [id])
  clientName   String
  websiteUrl   String
  logoUrl      String?
  brandPrimary String        @default("#4F8EF7")
  brandSecondary String      @default("#1A1A2E")
  timezone     String        @default("UTC")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  integrations Integration[]
  tasks        Task[]
  reports      Report[]
  gscSnapshots GscSnapshot[]
  pageSnapshots PageSnapshot[]
  promptTemplates PromptTemplate[]
}

model Integration {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         String   // gsc, sheets, wordpress, github
  credentials  String?  @db.Text // AES-256 encrypted JSON
  config       Json?    // non-sensitive config (sheet URL, repo name, etc.)
  status       String   @default("disconnected") // connected, disconnected, error
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, type])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assigneeId  String?
  assignee    User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?     @relation("CreatedTasks", fields: [createdById], references: [id])
  status      String    @default("pending") // pending, in_progress, done
  dueDate     DateTime?
  completedAt DateTime?
  weekStart   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Report {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String          @default("queued") // queued, generating, ready, failed
  dateFrom     DateTime
  dateTo       DateTime
  promptUsed   String?         @db.Text
  promptTemplateId String?
  customNotes  String?         @db.Text
  pdfUrl       String?
  errorMessage String?
  brandConfig  Json?
  sections     ReportSection[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ReportSection {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sectionKey String   // executiveSummary, gscInsights, tasksCompleted, pagesPublished, recommendations, nextWeekPlan
  title      String
  content    String   @db.Text
  orderIndex Int
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PromptTemplate {
  id          String       @id @default(cuid())
  orgId       String?
  organization Organization? @relation(fields: [orgId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  name        String
  body        String       @db.Text
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GscSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date         DateTime
  clicks       Int      @default(0)
  impressions  Int      @default(0)
  ctr          Float    @default(0)
  position     Float    @default(0)
  topPages     Json?
  topQueries   Json?
  createdAt    DateTime @default(now())

  @@unique([projectId, date])
}

model PageSnapshot {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      String   // wordpress, github
  title       String
  url         String
  publishedAt DateTime
  createdAt   DateTime @default(now())
}
